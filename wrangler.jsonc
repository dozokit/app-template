{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dozokit-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: the Deploy to Cloudflare button creates the database.
  "d1_databases": [
    { "binding": "DB", "database_name": "dozokit-app-db", "migrations_dir": "migrations" }
  ],
  // Draft previews (any branch but main) get their own database, never the live one.
  // scripts/preview-db.mjs creates it in Cloudflare's build and fills in its id.
  "previews": {
    "vars": { "PREVIEW": "1" },
    "d1_databases": [
      { "binding": "DB", "database_name": "dozokit-app-preview-db", "migrations_dir": "migrations" }
    ]
  },
  // Sign-in calls: 5 a minute per visitor; public routes: 30. namespace_id only has to be unique in your
  // Cloudflare account: change it if another app there uses the same one.
  "ratelimits": [
    { "name": "AUTH_LIMIT", "namespace_id": "4101", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUBLIC_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ],
  // Workers Logs: shows each request's CPU time in the dashboard.
  "observability": { "enabled": true }
}
