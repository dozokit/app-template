{
  "name": "dozokit-app",
  "scripts": {
    "check": "node scripts/check-routes.mjs",
    "build": "node scripts/check-routes.mjs && tsc && vite build",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "dev": "npm run build && npm run db:migrate && wrangler dev",
    "deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "better-auth": "^1.7.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "wrangler": "^4.153.0"
  },
  "private": true,
  "type": "module"
}
